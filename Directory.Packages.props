<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The measuring tool for `cognitive_complexity_max` in .agentic/quality-gates.yaml (ADR 0050).
         Cognitive complexity is a Sonar metric (rule S3776); the .NET SDK ships no equivalent, which is
         why that gate was unmeasurable — and unfalsifiable — before this.
         GlobalPackageReference, not PackageVersion + per-project PackageReference: it applies to every
         project and implies PrivateAssets="all", which is exactly right for a build-time analyzer (it
         must never flow to consumers as a dependency).
         Exactly ONE of its ~400 rules is adopted; see .editorconfig for the measurement behind that. -->
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.33.0.1635" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="13.5.2" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.5.2" />
    <PackageVersion Include="Aspire.Hosting.Orleans" Version="13.5.2" />
    <PackageVersion Include="Aspire.Microsoft.Azure.Cosmos" Version="13.5.2" />
    <!-- Content parsing + Azure + AI -->
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.ResourceManager.CognitiveServices" Version="1.5.2" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />
    <!-- Security pin, not a feature dependency. Azure.Extensions.AspNetCore.DataProtection.Blobs
         -> Microsoft.AspNetCore.DataProtection 10.0.7 drags in System.Security.Cryptography.Xml
         10.0.7, which carries four known high-severity advisories. Pinned directly (with a matching
         PackageReference in Agent42.Backend) because Central Package Management does not override a
         transitive version from a PackageVersion entry alone. Drop this pin once the DataProtection
         chain ships a fixed version by itself. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageVersion Include="Docnet.Core" Version="2.6.0" />
    <!-- Long-term memory (ADR 0056). Our own package, extracted to a public repo so it is usable outside
         this codebase: https://github.com/Expecho/Hindsight.AgentFramework.Net -->
    <PackageVersion Include="Hindsight.AgentFramework.Net" Version="0.1.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.88.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <!-- Held at 2.12.0 deliberately; do NOT let a routine outdated-package sweep
         raise it. OpenAI 2.13.0 regressed StreamingChatCompletionUpdate's JsonPatch propagator: a
         streaming chunk with an EMPTY `choices` array throws ArgumentOutOfRangeException, because
         PropagateGet indexes Choices[index] with no bounds check and 2.13.0 routes the read through
         that indexer instead of resolving it from stored JSON. Microsoft.Extensions.AI.OpenAI probes
         "$.choices[0].delta.reasoning_content" on EVERY streaming update, so the whole stream dies.
         Azure emits exactly such chunks (the leading prompt_filter_results chunk, and the trailing
         usage-only one), which takes out the Chat Completions path in ChatClientFactory
         (Provider.OpenAICompatible, and Foundry when UseResponsesApi is false).
         Measured: 2.12.0 returns found=False, 2.13.0 throws — StreamingEmptyChoicesTests pins it.
         Microsoft reached the same conclusion independently: Microsoft.Extensions.AI.OpenAI 10.9.0
         (referenced directly below for exactly this reason) declares OpenAI [2.12.0, 2.13.0), an
         exclusive upper bound that makes this pin self-enforcing at restore time. -->
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <!-- Direct, not transitive-by-accident. Microsoft.Agents.AI.OpenAI 1.19.0 asks only for
         >= 10.6.0, whose OpenAI dependency is min-only (2.10.0) and so lets 2.13.0 float in.
         10.9.0's exclusive upper bound is what turns the pin above into a restore-time error
         rather than a comment. Needs a matching PackageReference in Agent42.Backend: under CPM a
         PackageVersion entry alone does not override a transitive version (same reason as the
         System.Security.Cryptography.Xml pin above). -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <!-- Orleans -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.Cosmos" Version="10.2.2" />
    <PackageVersion Include="Microsoft.Orleans.Reminders" Version="10.2.2" />
    <PackageVersion Include="Microsoft.Orleans.Reminders.Cosmos" Version="10.2.2" />
    <PackageVersion Include="Microsoft.Orleans.Runtime" Version="10.2.2" />
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.2.2" />
    <PackageVersion Include="Microsoft.Orleans.TestingHost" Version="10.2.2" />
    <!-- Telemetry + resilience (ServiceDefaults) -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="WebPush" Version="1.0.13" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>