<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The measuring tool for `cognitive_complexity_max` in .agentic/quality-gates.yaml (ADR 0050).
         Cognitive complexity is a Sonar metric (rule S3776); the .NET SDK ships no equivalent, which is
         why that gate was unmeasurable — and unfalsifiable — before this.
         GlobalPackageReference, not PackageVersion + per-project PackageReference: it applies to every
         project and implies PrivateAssets="all", which is exactly right for a build-time analyzer (it
         must never flow to consumers as a dependency).
         Exactly ONE of its ~400 rules is adopted; see .editorconfig for the measurement behind that. -->
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.34.0.3385" />
  </ItemGroup>
  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.Orleans" Version="13.5.4" />
    <PackageVersion Include="Aspire.Microsoft.Azure.Cosmos" Version="13.5.4" />
    <!-- Content parsing + Azure + AI -->
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.9.0" />
    <PackageVersion Include="Azure.ResourceManager.CognitiveServices" Version="1.6.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />
    <!-- Security pin, not a feature dependency. Azure.Extensions.AspNetCore.DataProtection.Blobs
         -> Microsoft.AspNetCore.DataProtection 10.0.7 drags in System.Security.Cryptography.Xml
         10.0.7, which carries four known high-severity advisories. Pinned directly (with a matching
         PackageReference in Agent42.Backend) because Central Package Management does not override a
         transitive version from a PackageVersion entry alone. Drop this pin once the DataProtection
         chain ships a fixed version by itself. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageVersion Include="Docnet.Core" Version="2.6.0" />
    <!-- Shared state (ADR 0089): RFC 6902 ops applied to a JsonObject. First-party; SharedStatePatch is the only
         caller. NOT atomic on its own (measured: a failing `test` op leaves the earlier ops applied), so the
         caller patches a clone and commits only on success. -->
    <PackageVersion Include="Microsoft.AspNetCore.JsonPatch.SystemTextJson" Version="10.0.12" />
    <!-- Long-term memory (ADR 0056). Our own package, extracted to a public repo so it is usable outside
         this codebase: https://github.com/Expecho/Hindsight.AgentFramework.Net -->
    <PackageVersion Include="Hindsight.AgentFramework.Net" Version="0.1.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="MessagePack" Version="3.1.10" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.23.0" />
    <!-- The copilot agent kind needs >= 1.23.0: 1.22.0 drops CreateSessionFsProvider when it resumes a
         session, so a Blob-backed (SessionFs) Copilot session cannot be resumed. Keep the AF family in step. -->
    <PackageVersion Include="Microsoft.Agents.AI.GitHub.Copilot" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.23.0" />
    <!-- The agent fleet (ADR 0097): workflows for the team patterns, and declarative YAML agents. Declarative has
         never shipped a stable version, only the lockstep `x.y.0-rc1` of the AF family. Pinning it is a recorded
         exception to hard rule 4 (ADR 0097). Move it to stable once one exists, and keep both in step with the family. -->
    <PackageVersion Include="Microsoft.Agents.AI.Declarative" Version="1.23.0-rc1" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.23.0" />
    <!-- A direct pin (with a matching PackageReference in Agent42.Backend): it fixes the Copilot CLI
         runtime version, which the SDK's build targets download per RID and SHA256-check. -->
    <PackageVersion Include="GitHub.Copilot.SDK" Version="1.0.16" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.90.1" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- Before bumping, run StreamingEmptyChoicesTests. OpenAI 2.13.0 regressed
         StreamingChatCompletionUpdate's JsonPatch propagator: a streaming chunk with an EMPTY
         `choices` array threw ArgumentOutOfRangeException, and because Microsoft.Extensions.AI.OpenAI
         probes "$.choices[0].delta.reasoning_content" on EVERY update, the whole stream died (Azure
         sends such chunks; this hits the Chat Completions path in ChatClientFactory). The app was held
         at 2.12.0 until 2.14.0, which passes that test (measured 2026-09-24). No restore-time guard is
         left: M.E.AI.OpenAI 10.10.0 requires OpenAI >= 2.13.0 with no upper bound, so the test is the
         only thing that catches a recurrence. See the gotchas entry. -->
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <!-- A direct reference. The multi-provider factory calls its AsIChatClient() extensions itself.
         It needs a matching PackageReference in Agent42.Backend: under CPM, a PackageVersion entry
         alone does not override a transitive version (the same reason as the
         System.Security.Cryptography.Xml pin above). Before bumping it or OpenAI, also run
         ResponsesToolMappingTests: 10.10.0 against OpenAI 2.14.0 threw TypeLoadException
         (GlobalMcpToolCallApprovalPolicy) on every Responses turn that carried a tool. -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <!-- Orleans -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <!-- The OFFICIAL dashboard (ADR 0062), versioned with the rest of the Orleans stack.
         NOT the community `OrleansDashboard` package, which must never be referenced here:
         8.2.0 throws MissingMethodException out of Silo.StartAsync on Orleans 10.x, so the SILO
         NEVER STARTS — in ACA that is a crash-looping container that takes the whole app down.
         It was deprecated in Nov 2025 and merged into dotnet/orleans. QualityGateTests pins the ban. -->
    <PackageVersion Include="Microsoft.Orleans.Dashboard" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.Cosmos" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.Reminders" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.Reminders.Cosmos" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.Runtime" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.TestingHost" Version="10.3.1" />
    <!-- Telemetry + resilience (ServiceDefaults) -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="WebPush" Version="1.0.13" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>