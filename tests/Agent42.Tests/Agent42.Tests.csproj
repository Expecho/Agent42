<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
    <!-- Direct, not transitive: Microsoft.Agents.AI.GitHub.Copilot's buildTransitive imports the CLI download
         targets of the SDK version IT was packed against (an older CLI) unless the project references the SDK
         itself. Without this the output gets a different copilot runtime than the Backend. -->
    <PackageReference Include="GitHub.Copilot.SDK" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- Backend is referenced so its minimal-API endpoints can be hosted in-memory
       (TestServer) for HTTP-contract tests; it brings the ASP.NET shared framework. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Agent42.Agents\Agent42.Agents.csproj" />
    <ProjectReference Include="..\..\src\Agent42.Backend\Agent42.Backend.csproj" />
    <!-- The local bridge helper (ADR 0076). Its types under test are public: this repo has no InternalsVisibleTo. -->
    <ProjectReference Include="..\..\tools\Agent42.LocalBridge\Agent42.LocalBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>