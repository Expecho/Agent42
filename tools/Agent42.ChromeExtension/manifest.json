{
  "manifest_version": 3,
  "name": "Agent42 browser bridge",
  "version": "0.0.0",
  "version_name": "dev",
  "description": "Lets your Agent42 conversations use this Chrome through the Agent42 local bridge.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Agent42 browser bridge",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "116"
}
