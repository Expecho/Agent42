<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct, not transitive: Microsoft.Agents.AI.GitHub.Copilot's buildTransitive imports the CLI download
         targets of the SDK version IT was packed against (an older CLI) unless the project references the SDK
         itself. Without this the output gets a different copilot runtime than the Backend. -->
    <PackageReference Include="GitHub.Copilot.SDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Agent42.Backend\Agent42.Backend.csproj" />
  </ItemGroup>

</Project>
