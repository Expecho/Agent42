<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>54392407-ed0a-4bd1-aee7-ebb89bbb8b9a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep this a DIRECT reference. NuGet does not import a transitive package's build/ targets, so without it
         the AppHost loses its path metadata and AddDotnetProject resolves "../Agent42.Backend/..." against the
         working directory instead of this project (Backend is then "not found"). -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Azure.CosmosDB" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.Orleans" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Aspire.Hosting" />
    <Using Include="Aspire.Hosting.ApplicationModel" />
  </ItemGroup>

</Project>
