<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>543cd82b-60e1-4bbf-96c7-d38c0341c8fe</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Aspire.Microsoft.Azure.Cosmos" />
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.ResourceManager.CognitiveServices" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Persistence.Cosmos" />
    <PackageReference Include="Microsoft.Orleans.Reminders.Cosmos" />
    <!-- Direct reference (transitive via Microsoft.Agents.AI.OpenAI) because the multi-provider
         factory constructs OpenAIClient itself, with an ApiKeyCredential and a custom Endpoint, to
         reach any OpenAI-compatible provider (ADR 0013); version is centrally pinned. -->
    <PackageReference Include="OpenAI" />
    <!-- Direct reference (transitive via ServiceDefaults) so AspNetCoreTraceInstrumentationOptions
         is unambiguously in scope for the user.* trace enrichment; version is centrally pinned. -->
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent42.Agents\Agent42.Agents.csproj" />
    <ProjectReference Include="..\Agent42.ServiceDefaults\Agent42.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
