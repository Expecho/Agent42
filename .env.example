# Copy to .env (git-ignored) and set both values. Plain letters and digits are safest: the Postgres password is also
# embedded in a connection string.
POSTGRES_PASSWORD=change-me
SEARXNG_SECRET=change-me-to-a-long-random-string

# Optional. Which published image to run: `latest` (the default) follows main, or pin a release such as `1.2.3`, or a commit
# as `sha-abc1234`. AGENT42_REGISTRY points compose at another registry (a fork's ghcr.io/<you>, or your own).
# AGENT42_VERSION=latest
# AGENT42_REGISTRY=ghcr.io/expecho

# --- compose.azure.yaml only: Azure storage + Entra sign-in (ADR 0145, docs/setup/docker-entra.md) ---
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=            # a service principal with the Cosmos data-plane and Storage Blob Data Contributor roles
# AZURE_CLIENT_SECRET=
# AUTH_CLIENT_ID=             # the Entra app registration users sign in through (redirect URI <base>/signin-oidc)
# AUTH_CLIENT_SECRET=
# AUTH_PUBLIC_BASE_URL=       # only behind a proxy that rewrites Host, e.g. https://agent42.example.com
# COSMOS_ACCOUNT_ENDPOINT=https://<account>.documents.azure.com:443/
# BLOB_ENDPOINT=https://<account>.blob.core.windows.net
# OWNER_OBJECT_ID=            # your own Entra object id; never local-dev
