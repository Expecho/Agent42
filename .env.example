# Copy to .env (git-ignored) and set both values. Plain letters and digits are safest: the Postgres password is also
# embedded in a connection string.
POSTGRES_PASSWORD=change-me
SEARXNG_SECRET=change-me-to-a-long-random-string

# Optional. Which published image to run: `latest` (the default) follows main, or pin a release such as `1.2.3`, or a commit
# as `sha-abc1234`. AGENT42_REGISTRY points compose at another registry (a fork's ghcr.io/<you>, or your own).
# AGENT42_VERSION=latest
# AGENT42_REGISTRY=ghcr.io/expecho
