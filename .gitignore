# .NET
bin/
obj/
*.user
*.suo
.vs/

# Frontend
node_modules/
dist/
.env*.local

# OS
Thumbs.db
.DS_Store

# IDE
.idea/
.vscode/

# Claude Code — track shared config, skills, and hooks (repo infrastructure that
# CLAUDE.md and .agentic/ reference); ignore only the per-developer local override.
.claude/settings.local.json
.playwright-cli/
.claude/worktrees/

# Local run logs
*.log

# Secrets — User Secrets live in %APPDATA%\Microsoft\UserSecrets, not the repo
# Android release signing keys: CI decodes them from secrets (android.yml); a committed key is a leaked key.
*.jks
*.keystore

# Test coverage output (dotnet test --collect)
TestResults/

# Throwaway runtime spikes (referenced by .agentic/specs, never committed)
scratchpad/



# Live-model test credentials (LiveModelChatTests) — never commit.
live-model.local.json
live-anthropic.local.json
live-github.local.json

# Self-hosting secrets (compose.yaml reads .env; .env.example is the template)
.env
